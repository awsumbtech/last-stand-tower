      "note": "frame center = entity position"
    },
    "hitbox": {
      "r": 18,
      "units": "frame px",
      "worldRadius": 9,
      "pxPerWorldUnit": 2
    },
    "body": {
      "r": 24.3,
      "outline": 6,
      "drawScale": 1.35,
      "units": "frame px",
      "note": "drawn like cartoon.js: body radius = hitbox x drawScale"
    },
    "palette": {
      "ink": "#2b1d3a",
      "white": "#ffffff",
      "pow": "#fff3b0",
      "mouth": "#7a2840",
      "puff": "#ffffff",
      "body": "#ffd23f",
      "shade": "#e8b417"
    },
    "layer": {
      "name": "face",
      "of": "fast",
      "order": 1,
      "rotates": false,
      "note": "eye whites, blink, hurt eyes and the death O mouth (pupils come from fast_pupil.png, placed by the code like Basic's); always drawn upright on top of the body. Draw the layers in 'order' (0 first) with the same frame index, both at the entity position + frames[name].offset (screen space, frame px: the walk bob, applied after rotating); they share frame size, pivot and timing."
    },
    "pupils": {
      "image": "fast_pupil.png",
      "size": {
        "w": 12,
        "h": 12
      },
      "pivot": {
        "x": 0.5,
        "y": 0.5
      },
      "r": 3.65,
      "maxOffset": 2.55,
      "units": "frame px",
      "perFrame": "frames[name].eyes = [{x, y, whiteR, pupilR, maxOffset, authoredLook}] for the left then right eye, x/y relative to the pivot (layer sheets: before adding the frame offset); [] when the eyes are shut or hidden (blink, hurt, death burst): draw no pupils then.",
      "howTo": "Like cartoon.js eyes(): pupil centre = eye centre + (cos(look), sin(look)) * maxOffset, look = angle to the tower; draw the pupil sprite (scaled by pupilR / r) on top of the sprite. authoredLook is the -1..1 direction the frame was drawn for (idle glances), as a fallback."
    },
    "quantize": {
      "tool": "pngquant 3.0.3",
      "quality": "85-100",
      "dither": 0.5,
      "before": 11408,
      "after": 1656,
      "psnr": null,
      "maxChannelError": 0
    }
  }
